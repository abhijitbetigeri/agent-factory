# Copy to .env (gitignored). Never commit real values.

# --- Region: pick ONE and keep it consistent across Port and SigNoz ---
REGION=us                      # us | eu

# --- Port ---
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=            # machine credentials for unattended/CI runs
PORT_MCP_URL=https://mcp.us.port.io/v1     # EU: https://mcp.port.io/v1

# --- Bright Data ---
BRIGHTDATA_API_KEY=
SCRAPER_STUDIO_COLLECTOR_ID=
SCRAPER_TARGET_URL=
SCRAPER_REQUIRED_FIELDS=
SCRAPER_NULL_RATE_THRESHOLD=0.05

# --- SigNoz ---
SIGNOZ_INGESTION_KEY=
SIGNOZ_REGION=us
OTEL_SERVICE_NAME=factory-orchestrator
