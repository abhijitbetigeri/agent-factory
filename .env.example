# Copy to .env (gitignored). Never commit real values.

# --- Region: pick ONE and keep it consistent across Port and SigNoz ---
REGION=us                      # us | eu

# --- Port ---
PORT_CLIENT_ID=
PORT_CLIENT_SECRET=            # machine credentials for unattended/CI runs
PORT_MCP_URL=https://mcp.us.port.io/v1     # EU: https://mcp.port.io/v1

# --- Bright Data ---
BRIGHTDATA_API_KEY=
SCRAPER_REAL_COLLECTOR_ID=
SCRAPER_REAL_TARGET_URL=
SCRAPER_REQUIRED_FIELDS=
SCRAPER_NULL_RATE_THRESHOLD=0.05

# --- SigNoz ---
# Pick ONE. Getting this wrong is silent: the SDK falls back to the console
# exporter and the dashboard sits empty while everything looks healthy.
#   self-hosted (docker compose, see casting.yaml) -> set the endpoint, leave the key empty:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   cloud -> set the key, leave the endpoint empty:
SIGNOZ_INGESTION_KEY=
SIGNOZ_REGION=us
OTEL_SERVICE_NAME=factory-orchestrator
