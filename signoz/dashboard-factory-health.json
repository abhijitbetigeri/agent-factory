  "spec": {
    "display": {
      "name": "Mise OS \u2014 factory health",
      "description": "Built to answer 'what broke?' in under 30 seconds: the data contract, stage latency, endpoint and worker throughput, and feed freshness."
    },
    "variables": [],
    "panels": {
      "0be02d14-989d-4cc4-83dd-861bcbb8eb40": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Data contract \u2014 supplier price null-rate",
            "description": "THE sensor. Crossing 0.05 opens an incident and blocks release. The legacy menu null-rate (0.5625) is shown alongside as the defect that motivated the project."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "expression": "avg(supplier.price_null_rate)"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "groupBy": [],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "supplier feed (live contract)"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "expression": "avg(menu.price_null_rate)"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "groupBy": [],
                          "order": [],
                          "having": {
                            "expression": ""
                          },
                          "functions": [],
                          "legend": "menu prices (legacy defect)"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
