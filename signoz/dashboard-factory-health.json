      "bfc46635-50b6-4ddd-920b-8dfaaad0ad5b": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Data contract \u2014 supplier price null-rate",
            "description": "THE sensor. Crossing 0.05 opens an incident and blocks release. The legacy menu null-rate (0.5625) is alongside as the defect that motivated the project."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "none",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": {}
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [
                            {
                              "metricName": "supplier.price_null_rate",
                              "temporality": "",
                              "timeAggregation": "avg",
                              "spaceAggregation": "avg",
                              "reduceTo": "last"
                            }
                          ],
                          "disabled": false,
                          "filter": {
                            "expression": ""
                          },
                          "groupBy": [],
